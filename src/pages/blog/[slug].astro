---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { posts } from "../../data/posts";

export async function getStaticPaths() {
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const currentUrl = Astro.url.href;
const shareText = encodeURIComponent(`📖 ${post.title} - ALAYDE TECH`);
const shareUrl = encodeURIComponent(currentUrl);
const whatsappUrl = `https://wa.me/?text=${shareText}%20${shareUrl}`;
---

<BaseLayout title={post.title} description={post.description}>
  <section class="py-20 px-4 max-w-4xl mx-auto">
    <div>
      <a href="/blog" class="inline-flex items-center gap-2 text-[#1E3A8A] hover:text-[#F59E0B] transition text-sm mb-8">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Retour au blog
      </a>

      <article class="bg-white rounded-2xl shadow-lg p-6 md:p-10 border border-[#E2E8F0]">
        <h1 class="text-3xl md:text-4xl font-bold text-[#1E3A8A]">{post.title}</h1>
        <div class="flex items-center gap-3 text-sm text-[#64748B] mt-4">
          <span>{post.date}</span>
          <span class="w-1 h-1 bg-[#64748B] rounded-full"></span>
          <span>{post.author}</span>
        </div>
        <article class="prose prose-lg max-w-none">
          <div set:html={post.content} />
        </article>

        <!-- Pied d'article : Source + Bouton Partager -->
        <div class="mt-10 pt-6 border-t border-[#E2E8F0] flex flex-col sm:flex-row items-center justify-between gap-4">
          <div class="text-xs text-[#64748B]">
            Source : 
            <a href="https://alaydetech.com" class="text-[#1E3A8A] hover:text-[#F59E0B] transition font-medium">
              ALAYDE TECH
            </a>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-xs text-[#64748B]">Partager :</span>
            <a 
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 bg-[#25D366] hover:bg-[#1DA851] text-white text-sm font-medium px-4 py-2 rounded-full transition-all hover:scale-105 shadow-sm"
              aria-label="Partager sur WhatsApp"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              WhatsApp
            </a>

            <a 
              href={`https://www.facebook.com/sharer/sharer.php?u=${shareUrl}`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 bg-[#1877F2] hover:bg-[#166FE5] text-white text-sm font-medium px-4 py-2 rounded-full transition-all hover:scale-105 shadow-sm"
              aria-label="Partager sur Facebook"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
              Facebook
            </a>
          </div>
        </div>
      </article>
    </div>
  </section>
</BaseLayout>