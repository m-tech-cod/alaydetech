---
import BaseLayout from "../layouts/BaseLayout.astro";
import { projects } from "../data/projects";
import Icon from "../components/atoms/Icon.astro";
---

<BaseLayout title="Accueil" description="Alayde Tech conçoit des applications web, plateformes SaaS et solutions numériques sur mesure.">
  <!-- Hero Section -->
  <section class="relative min-h-[85vh] flex items-center justify-center px-4 overflow-hidden">
    <!-- Image de fond avec zoom -->
    <div class="absolute inset-0 z-0 overflow-hidden">
      <img 
        src="/images/fond.webp" 
        alt="Alayde Tech - Innovation numérique" 
        class="w-full h-full object-cover animate-zoom"
      />
      <div class="absolute inset-0 bg-gradient-to-br from-[#1E3A8A]/70 via-[#1E3A8A]/40 to-[#F59E0B]/30"></div>
    </div>

    <!-- Contenu Hero (relatif pour être au-dessus) -->
    <div class="relative z-10 max-w-4xl mx-auto text-center">
      <span class="inline-flex items-center gap-1.5 bg-[#F59E0B]/20 text-white text-xs sm:text-sm font-semibold px-4 py-1.5 rounded-full mb-6 backdrop-blur-sm">
        <Icon name="sparkle" class="w-3.5 h-3.5" />
        Agence de développement logiciel
      </span>
      
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white leading-tight drop-shadow-lg">
        Des logiciels qui<br />
        <span class="text-[#F59E0B] typewriter" data-words='["changent la donne", "accélèrent", "simplifient", "connectent"]'></span>
      </h1>

      <p class="mt-6 text-base sm:text-lg text-white/90 max-w-2xl mx-auto drop-shadow-md">
        Alayde Tech conçoit des applications web et des plateformes SaaS sur mesure.
      </p>

      <div class="mt-10 flex flex-wrap gap-4 justify-center">
        <a href="/contact" class="bg-[#F59E0B] text-[#1E3A8A] font-semibold px-6 sm:px-8 py-3 sm:py-4 rounded-xl hover:bg-[#D97706] transition-all hover:shadow-xl hover:-translate-y-0.5 text-sm sm:text-base">
          Discuter de votre projet
        </a>
        <a href="/projects" class="border-2 border-white text-white font-semibold px-6 sm:px-8 py-3 sm:py-4 rounded-xl hover:bg-white/10 transition-all hover:shadow-xl hover:-translate-y-0.5 text-sm sm:text-base backdrop-blur-sm">
          Voir nos réalisations
        </a>
      </div>

      <div class="mt-12 grid grid-cols-3 gap-4 max-w-lg mx-auto">
        <div>
          <p class="text-2xl sm:text-3xl font-bold text-white drop-shadow-md">
            <span class="stat-number" data-target="10">0+</span>
          </p>
          <p class="text-xs text-white/80">Projets</p>
        </div>
        <div>
          <p class="text-2xl sm:text-3xl font-bold text-white drop-shadow-md">
            <span class="stat-number" data-target="5">0+</span>
          </p>
          <p class="text-xs text-white/80">ONG</p>
        </div>
        <div>
          <p class="text-2xl sm:text-3xl font-bold text-white drop-shadow-md">
            <span class="stat-number" data-target="100">0+</span>
          </p>
          <p class="text-xs text-white/80">Satisfaction</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Pourquoi Alayde Tech -->
  <section class="reveal py-16 px-4 max-w-6xl mx-auto">
    <div class="text-center mb-12">
      <span class="text-sm font-semibold text-[#F59E0B] uppercase tracking-wider">Pourquoi nous choisir</span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-[#1E3A8A] mt-2">
        3 raisons de faire <span class="text-[#F59E0B]">confiance</span>
      </h2>
    </div>

    <div class="grid sm:grid-cols-3 gap-6">
      <div class="bg-white rounded-2xl shadow-lg p-6 text-center border border-[#E2E8F0] hover:shadow-xl transition animate-fade-in-up animate-delay-1">
        <div class="mb-4 flex justify-center text-[#1E3A8A]"><Icon name="laptop" class="w-12 h-12" /></div>
        <h3 class="text-xl font-semibold text-[#1E3A8A]">Solutions sur mesure</h3>
        <p class="text-sm text-[#64748B] mt-2">Chaque projet est unique et adapté à vos besoins spécifiques.</p>
      </div>
      <div class="bg-white rounded-2xl shadow-lg p-6 text-center border border-[#E2E8F0] hover:shadow-xl transition animate-fade-in-up animate-delay-2">
        <div class="mb-4 flex justify-center text-[#F59E0B]"><Icon name="bolt" class="w-12 h-12" /></div>
        <h3 class="text-xl font-semibold text-[#1E3A8A]">Technologies modernes</h3>
        <p class="text-sm text-[#64748B] mt-2">Nous utilisons les dernières technologies pour des résultats optimaux.</p>
      </div>
      <div class="bg-white rounded-2xl shadow-lg p-6 text-center border border-[#E2E8F0] hover:shadow-xl transition animate-fade-in-up animate-delay-3">
        <div class="mb-4 flex justify-center text-[#1E3A8A]"><Icon name="handshake" class="w-12 h-12" /></div>
        <h3 class="text-xl font-semibold text-[#1E3A8A]">Accompagnement continu</h3>
        <p class="text-sm text-[#64748B] mt-2">Nous vous accompagnons avant, pendant et après la mise en ligne.</p>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="reveal py-16 px-4 max-w-6xl mx-auto">
    <div class="text-center mb-12">
      <span class="text-sm font-semibold text-[#F59E0B] uppercase tracking-wider">Nos services</span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-[#1E3A8A] mt-2">Des solutions <span class="text-[#F59E0B]">sur mesure</span></h2>
      <p class="text-[#64748B] mt-4 max-w-2xl mx-auto">Du développement web aux plateformes SaaS, nous créons des outils numériques adaptés à vos besoins.</p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      <div class="bg-white rounded-2xl shadow-lg p-6 text-center hover:shadow-xl transition border border-[#E2E8F0] animate-fade-in-up animate-delay-1">
        <div class="w-14 h-14 bg-[#1E3A8A]/10 rounded-xl flex items-center justify-center text-[#1E3A8A] mx-auto mb-4"><Icon name="globe" class="w-7 h-7" /></div>
        <h3 class="text-xl font-semibold text-[#1E3A8A]">Développement Web</h3>
        <p class="text-[#64748B] text-sm mt-2">Sites vitrines, applications web complexes et plateformes sur mesure.</p>
      </div>
      <div class="bg-white rounded-2xl shadow-lg p-6 text-center hover:shadow-xl transition border border-[#E2E8F0] animate-fade-in-up animate-delay-2">
        <div class="w-14 h-14 bg-[#10B981]/10 rounded-xl flex items-center justify-center text-[#10B981] mx-auto mb-4"><Icon name="cloud" class="w-7 h-7" /></div>
        <h3 class="text-xl font-semibold text-[#1E3A8A]">SaaS & Plateformes</h3>
        <p class="text-[#64748B] text-sm mt-2">Solutions logicielles en tant que service, évolutives et sécurisées.</p>
      </div>
      <div class="bg-white rounded-2xl shadow-lg p-6 text-center hover:shadow-xl transition border border-[#E2E8F0] animate-fade-in-up animate-delay-3">
        <div class="w-14 h-14 bg-[#F59E0B]/10 rounded-xl flex items-center justify-center text-[#F59E0B] mx-auto mb-4"><Icon name="building" class="w-7 h-7" /></div>
        <h3 class="text-xl font-semibold text-[#1E3A8A]">Solutions Métier</h3>
        <p class="text-[#64748B] text-sm mt-2">Outils internes, ERP, CRM et applications métier personnalisées.</p>
      </div>
      <div class="bg-white rounded-2xl shadow-lg p-6 text-center hover:shadow-xl transition border border-[#E2E8F0] animate-fade-in-up animate-delay-2">
        <div class="w-14 h-14 bg-[#1E3A8A]/10 rounded-xl flex items-center justify-center text-[#1E3A8A] mx-auto mb-4"><Icon name="handshake" class="w-7 h-7" /></div>
        <h3 class="text-xl font-semibold text-[#1E3A8A]">Solutions ONG</h3>
        <p class="text-[#64748B] text-sm mt-2">Plateformes de gestion, collecte de fonds et suivi de projets humanitaires.</p>
      </div>
      <div class="bg-white rounded-2xl shadow-lg p-6 text-center hover:shadow-xl transition border border-[#E2E8F0] animate-fade-in-up animate-delay-3">
        <div class="w-14 h-14 bg-[#10B981]/10 rounded-xl flex items-center justify-center text-[#10B981] mx-auto mb-4"><Icon name="wrench" class="w-7 h-7" /></div>
        <h3 class="text-xl font-semibold text-[#1E3A8A]">Maintenance & Support</h3>
        <p class="text-[#64748B] text-sm mt-2">Support technique, maintenance évolutive et optimisation continue.</p>
      </div>
      <div class="bg-white rounded-2xl shadow-lg p-6 text-center hover:shadow-xl transition border border-[#E2E8F0] animate-fade-in-up animate-delay-4">
        <div class="w-14 h-14 bg-[#F59E0B]/10 rounded-xl flex items-center justify-center text-[#F59E0B] mx-auto mb-4"><Icon name="target" class="w-7 h-7" /></div>
        <h3 class="text-xl font-semibold text-[#1E3A8A]">Sites Vitrines</h3>
        <p class="text-[#64748B] text-sm mt-2">Sites institutionnels, landing pages et vitrines digitales modernes.</p>
      </div>
    </div>
  </section>

  <!-- Réalisations -->
  <section class="reveal py-16 px-4 max-w-6xl mx-auto">
    <div class="text-center mb-12">
      <span class="text-sm font-semibold text-[#F59E0B] uppercase tracking-wider">Nos réalisations</span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-[#1E3A8A] mt-2">Des projets qui <span class="text-[#F59E0B]">parlent</span></h2>
      <p class="text-[#64748B] mt-4 max-w-2xl mx-auto">Découvrez quelques-uns de nos projets récents.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {projects
        .filter(p => p.featured === true)
        .slice(0, 3)
        .map((project, index) => {
          const isUpcoming = project.link === "#";
          const Tag = isUpcoming ? "div" : "a";
          return (
            <Tag
              href={isUpcoming ? undefined : project.link}
              target={isUpcoming ? undefined : "_blank"}
              rel={isUpcoming ? undefined : "noopener noreferrer"}
              class={`group bg-white rounded-2xl shadow-lg ${isUpcoming ? "" : "hover:shadow-xl hover:-translate-y-1"} transition-all duration-300 overflow-hidden border border-[#E2E8F0] animate-fade-in-up animate-delay-${(index % 3) + 1}`}
            >
              <div class="h-48 overflow-hidden bg-gradient-to-br from-[#1E3A8A]/10 to-[#F59E0B]/10 relative flex items-center justify-center">
                {project.image ? (
                  <img src={project.image} alt={project.title} class="w-full h-full object-cover group-hover:scale-105 transition duration-500" loading="lazy" />
                ) : (
                  <Icon name="rocket" class="w-10 h-10 text-[#1E3A8A]/40" />
                )}
                <div class="absolute inset-0 bg-[#1E3A8A]/0 group-hover:bg-[#1E3A8A]/20 transition duration-500"></div>
              </div>
              <div class="p-5">
                <h3 class="text-lg font-semibold text-[#1E3A8A] group-hover:text-[#F59E0B] transition">
                  {project.title}
                  {isUpcoming && (
                    <span class="inline-block text-xs font-medium bg-[#F59E0B] text-white px-2 py-0.5 rounded-full ml-2 align-middle">
                      À venir
                    </span>
                  )}
                </h3>
                <p class="text-[#64748B] text-sm mt-1 line-clamp-2">{project.description}</p>
                {!isUpcoming && (
                  <span class="inline-flex items-center gap-1 mt-3 text-sm font-medium text-[#1E3A8A] group-hover:text-[#F59E0B] transition">
                    Voir le projet
                    <Icon name="arrow-right" class="w-4 h-4" />
                  </span>
                )}
              </div>
            </Tag>
          );
        })
      }
    </div>

    <div class="text-center mt-10">
      <a href="/projects" class="inline-flex items-center gap-2 text-[#1E3A8A] font-medium hover:text-[#F59E0B] transition group">
        Voir toutes nos réalisations
        <svg class="w-4 h-4 group-hover:translate-x-1 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </section>


  <!-- CTA avec image de fond et zoom -->
  <section class="reveal py-16 px-4 max-w-6xl mx-auto">
    <div class="relative overflow-hidden rounded-3xl text-center text-white">
      <!-- Image de fond -->
      <div class="absolute inset-0 z-0 overflow-hidden rounded-3xl">
        <img 
          src="/images/fond.webp" 
          alt="Alayde Tech - Prêt à innover" 
          class="w-full h-full object-cover animate-zoom"
        />
        <div class="absolute inset-0 bg-gradient-to-br from-[#1E3A8A]/80 to-[#1E3A8A]/60"></div>
      </div>

      <!-- Contenu CTA -->
      <div class="relative z-10 p-8 sm:p-12">
        <h2 class="text-3xl sm:text-4xl font-bold drop-shadow-md">Prêt à donner vie à votre projet ?</h2>
        <p class="text-white/90 text-lg mt-4 max-w-2xl mx-auto drop-shadow-md">Discutons de vos besoins et trouvons ensemble la solution idéale.</p>
        <a href="/contact" class="inline-block mt-8 bg-[#F59E0B] text-[#1E3A8A] font-semibold px-8 py-4 rounded-xl hover:bg-[#D97706] transition-all hover:shadow-xl hover:-translate-y-0.5">
          Démarrer un projet
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Machine à écrire - CORRECTION: ajout d'un try...catch
  document.addEventListener('DOMContentLoaded', () => {
    try {
      const el = document.querySelector('.typewriter');
      if (el) {
        const words = JSON.parse(el.dataset.words);
        let i = 0;
        setInterval(() => {
          el.textContent = words[i];
          i = (i + 1) % words.length;
        }, 2500);
      }
    } catch (error) {
      console.warn('Machine à écrire: élément non trouvé ou erreur de parsing', error);
    }
  });

  // Compteurs - CORRECTION: vérification de l'existence des éléments
  function animateCounters() {
    const counters = document.querySelectorAll('.stat-number');
    if (counters.length === 0) return; // Sortie si aucun compteur n'est trouvé
    
    counters.forEach(counter => {
      const target = parseInt(counter.getAttribute('data-target'));
      const duration = 2000;
      const step = target / (duration / 16);
      let current = 0;
      const updateCounter = () => {
        current += step;
        if (current < target) {
          counter.textContent = Math.floor(current) + '+';
          requestAnimationFrame(updateCounter);
        } else {
          counter.textContent = target + '+';
        }
      };
      updateCounter();
    });
  }

  function revealOnScroll() {
    const reveals = document.querySelectorAll('.reveal');
    reveals.forEach(element => {
      const windowHeight = window.innerHeight;
      const elementTop = element.getBoundingClientRect().top;
      const revealPoint = 150;
      if (elementTop < windowHeight - revealPoint) {
        element.classList.add('visible');
      }
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    animateCounters();
    revealOnScroll();
  });

  window.addEventListener('scroll', revealOnScroll);
</script>