---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/atoms/Icon.astro";
---

<BaseLayout title="À propos" description="Découvrez Alayde Tech, notre vision et nos engagements.">
  <!-- Hero À propos -->
  <section class="relative py-20 px-4 overflow-hidden min-h-[60vh] flex items-center justify-center">
    <!-- Image de fond avec zoom -->
    <div class="absolute inset-0 z-0 overflow-hidden">
      <img 
        src="/images/fond.webp" 
        alt="Alayde Tech - Innovation et impact social" 
        class="w-full h-full object-cover animate-zoom"
      />
      <div class="absolute inset-0 bg-gradient-to-br from-[#1E3A8A]/70 via-[#1E3A8A]/50 to-[#F59E0B]/30"></div>
    </div>

    <!-- Contenu Hero -->
    <div class="relative z-10 max-w-5xl mx-auto text-center">
      <span class="inline-flex items-center gap-1.5 bg-[#F59E0B]/20 text-white text-sm font-semibold px-4 py-1.5 rounded-full mb-6 backdrop-blur-sm">
        <Icon name="sparkle" class="w-3.5 h-3.5" />
        Notre histoire
      </span>
      <h1 class="text-4xl md:text-6xl font-bold text-white leading-tight drop-shadow-lg">
        La technologie au <br />
        <span class="text-[#F59E0B] relative">
          service de l'humain
          <svg class="absolute -bottom-2 left-0 w-full h-2 text-[#F59E0B]/50" viewBox="0 0 200 10" fill="currentColor">
            <ellipse cx="100" cy="5" rx="100" ry="3" />
          </svg>
        </span>
      </h1>
      <p class="mt-6 text-lg text-white/90 max-w-2xl mx-auto drop-shadow-md">
        Alayde Tech est un studio de création numérique qui allie innovation, technologie et impact social.
      </p>
    </div>
  </section>

  <!-- Notre vision -->
  <section class="py-12 px-4 max-w-6xl mx-auto">
    <div class="grid md:grid-cols-2 gap-12 items-center">
      <div>
        <span class="text-sm font-semibold text-[#F59E0B] uppercase tracking-wider">Notre vision</span>
        <h2 class="text-3xl md:text-4xl font-bold text-[#1E3A8A] mt-2">
          Innover pour <span class="text-[#F59E0B]">transformer</span>
        </h2>
        <p class="text-[#64748B] mt-4 leading-relaxed">
          Nous croyons que la technologie peut être un levier puissant pour créer un impact positif.
          Chaque projet que nous réalisons est pensé pour apporter une réelle valeur ajoutée.
        </p>
        <div class="mt-6 space-y-3">
          <div class="flex items-center gap-3">
            <div class="w-6 h-6 bg-[#F59E0B]/20 rounded-full flex items-center justify-center text-[#F59E0B]"><Icon name="check" class="w-3.5 h-3.5" /></div>
            <span class="text-[#64748B]">Des solutions sur mesure</span>
          </div>
          <div class="flex items-center gap-3">
            <div class="w-6 h-6 bg-[#F59E0B]/20 rounded-full flex items-center justify-center text-[#F59E0B]"><Icon name="check" class="w-3.5 h-3.5" /></div>
            <span class="text-[#64748B]">Une approche centrée utilisateur</span>
          </div>
          <div class="flex items-center gap-3">
            <div class="w-6 h-6 bg-[#F59E0B]/20 rounded-full flex items-center justify-center text-[#F59E0B]"><Icon name="check" class="w-3.5 h-3.5" /></div>
            <span class="text-[#64748B]">Un engagement pour l'impact social</span>
          </div>
        </div>
      </div>
      <div class="bg-gradient-to-br from-[#1E3A8A] to-[#2D4FA8] rounded-3xl p-8 text-white">
        <div class="mb-4"><Icon name="lightbulb" class="w-12 h-12" /></div>
        <h3 class="text-2xl font-bold">"La tech, c'est du vivant"</h3>
        <p class="text-white/80 mt-2 text-sm leading-relaxed">
          Derrière chaque ligne de code, il y a une volonté de créer des solutions utiles, durables et accessibles à tous.
        </p>
      </div>
    </div>
  </section>

  <!-- Nos valeurs -->
  <section class="py-16 px-4 max-w-6xl mx-auto">
    <div class="text-center mb-12">
      <span class="text-sm font-semibold text-[#F59E0B] uppercase tracking-wider">Ce qui nous guide</span>
      <h2 class="text-3xl md:text-4xl font-bold text-[#1E3A8A] mt-2">
        Nos <span class="text-[#F59E0B]">valeurs</span>
      </h2>
      <p class="text-[#64748B] mt-4 max-w-2xl mx-auto">
        Quatre piliers qui façonnent notre manière de travailler et de créer.
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
      <div class="bg-white rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-1 p-6 text-center group">
        <div class="w-16 h-16 bg-[#1E3A8A]/10 rounded-2xl flex items-center justify-center text-[#1E3A8A] mx-auto mb-4 group-hover:bg-[#1E3A8A] group-hover:text-white transition-all duration-300"><Icon name="lightbulb" class="w-8 h-8" /></div>
        <h3 class="text-lg font-semibold text-[#1E3A8A]">Innovation</h3>
        <p class="text-sm text-[#64748B] mt-2 leading-relaxed">Nous repoussons les limites pour vous offrir des solutions avant-gardistes.</p>
      </div>
      <div class="bg-white rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-1 p-6 text-center group">
        <div class="w-16 h-16 bg-[#10B981]/10 rounded-2xl flex items-center justify-center text-[#10B981] mx-auto mb-4 group-hover:bg-[#10B981] group-hover:text-white transition-all duration-300"><Icon name="bolt" class="w-8 h-8" /></div>
        <h3 class="text-lg font-semibold text-[#1E3A8A]">Technologie</h3>
        <p class="text-sm text-[#64748B] mt-2 leading-relaxed">Nous utilisons les meilleurs outils pour garantir performance et fiabilité.</p>
      </div>
      <div class="bg-white rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-1 p-6 text-center group">
        <div class="w-16 h-16 bg-[#F59E0B]/10 rounded-2xl flex items-center justify-center text-[#F59E0B] mx-auto mb-4 group-hover:bg-[#F59E0B] group-hover:text-white transition-all duration-300"><Icon name="palette" class="w-8 h-8" /></div>
        <h3 class="text-lg font-semibold text-[#1E3A8A]">Créativité</h3>
        <p class="text-sm text-[#64748B] mt-2 leading-relaxed">Chaque projet est unique, pensé pour se démarquer.</p>
      </div>
      <div class="bg-white rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-1 p-6 text-center group">
        <div class="w-16 h-16 bg-[#1E3A8A]/10 rounded-2xl flex items-center justify-center text-[#1E3A8A] mx-auto mb-4 group-hover:bg-[#1E3A8A] group-hover:text-white transition-all duration-300"><Icon name="target" class="w-8 h-8" /></div>
        <h3 class="text-lg font-semibold text-[#1E3A8A]">Professionnalisme</h3>
        <p class="text-sm text-[#64748B] mt-2 leading-relaxed">La rigueur et la qualité sont au cœur de notre démarche.</p>
      </div>
    </div>
  </section>

  <!-- Chiffres clés -->
  <section class="py-16 px-4 max-w-6xl mx-auto">
    <div class="bg-[#F8FAFC] rounded-3xl border border-[#E2E8F0] p-8 md:p-12">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        <div>
          <div class="text-3xl md:text-4xl font-bold text-[#1E3A8A]">20+</div>
          <p class="text-sm text-[#64748B] mt-1">Projets réalisés</p>
        </div>
        <div>
          <div class="text-3xl md:text-4xl font-bold text-[#1E3A8A]">10+</div>
          <p class="text-sm text-[#64748B] mt-1">ONG accompagnées</p>
        </div>
        <div>
          <div class="text-3xl md:text-4xl font-bold text-[#1E3A8A]">100%</div>
          <p class="text-sm text-[#64748B] mt-1">Satisfaction client</p>
        </div>
        <div>
          <div class="text-3xl md:text-4xl font-bold text-[#1E3A8A]">24/7</div>
          <p class="text-sm text-[#64748B] mt-1">Support disponible</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA final avec image de fond et zoom -->
  <section class="py-16 px-4 max-w-6xl mx-auto">
    <div class="relative overflow-hidden rounded-3xl text-center text-white">
      <!-- Image de fond -->
      <div class="absolute inset-0 z-0 overflow-hidden rounded-3xl">
        <img 
          src="/images/fond.webp" 
          alt="Alayde Tech - Prêt à collaborer" 
          class="w-full h-full object-cover animate-zoom"
        />
        <div class="absolute inset-0 bg-gradient-to-br from-[#1E3A8A]/80 to-[#1E3A8A]/60"></div>
      </div>

      <!-- Contenu CTA -->
      <div class="relative z-10 p-8 sm:p-12">
        <h2 class="text-3xl md:text-4xl font-bold drop-shadow-md">Prêt à collaborer avec nous ?</h2>
        <p class="text-white/90 text-lg mt-4 max-w-2xl mx-auto drop-shadow-md">
          Discutons de votre projet et trouvons ensemble la solution idéale.
        </p>
        <div class="mt-8 flex flex-wrap gap-4 justify-center">
          <a href="/contact" class="bg-[#F59E0B] text-[#1E3A8A] font-semibold px-8 py-3 rounded-xl hover:bg-[#D97706] transition-all hover:shadow-xl hover:-translate-y-0.5">
            Démarrer un projet
          </a>
          <a href="/projects" class="border-2 border-white/30 text-white font-semibold px-8 py-3 rounded-xl hover:bg-white/10 transition-all hover:shadow-xl backdrop-blur-sm">
            Voir nos réalisations
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>