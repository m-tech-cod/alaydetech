---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Contact" description="Contactez Alayde Tech pour vos projets web, SaaS ou solutions numériques.">
  <!-- Hero avec image de fond et zoom -->
  <section class="relative py-20 px-4 overflow-hidden min-h-[50vh] flex items-center justify-center">
    <div class="absolute inset-0 z-0 overflow-hidden">
      <div class="w-full h-full animate-zoom">
        <img 
          src="/images/fond.webp" 
          alt="Alayde Tech - Contactez-nous" 
          class="w-full h-full object-cover"
        />
      </div>
      <div class="absolute inset-0 bg-gradient-to-br from-[#1E3A8A]/70 via-[#1E3A8A]/50 to-[#F59E0B]/30"></div>
    </div>

    <div class="relative z-10 max-w-4xl mx-auto text-center">
      <h1 class="text-3xl md:text-5xl font-bold text-white leading-tight drop-shadow-lg">
        Prenons <span class="text-[#F59E0B]">contact</span>
      </h1>
      <p class="text-lg text-white/90 mt-4 max-w-2xl mx-auto drop-shadow-md">
        Vous avez un projet en tête ? Discutons-en ensemble.
      </p>
      <div class="w-20 h-1 bg-[#F59E0B] mx-auto mt-6 rounded"></div>
    </div>
  </section>

  <!-- Contenu principal (formulaire + infos) -->
  <section class="py-16 px-4 max-w-5xl mx-auto">
    <div class="grid md:grid-cols-2 gap-12">
      <!-- Formulaire -->
      <div class="bg-white rounded-xl shadow-md p-6 md:p-8">
        <h2 class="text-xl font-semibold text-[#1E3A8A] mb-6">Envoyez-nous un message</h2>

        <form
          id="contact-form"
          action="https://formspree.io/f/meenwbvo"
          method="POST"
          class="space-y-5"
        >
          <div>
            <label for="name" class="block text-sm font-medium text-gray-700 mb-1">
              Nom complet
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:ring-2 focus:ring-[#1E3A8A] focus:border-transparent transition"
              placeholder="Alain Dupuis"
            />
          </div>

          <div>
            <label for="email" class="block text-sm font-medium text-gray-700 mb-1">
              Email
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:ring-2 focus:ring-[#1E3A8A] focus:border-transparent transition"
              placeholder="vous@exemple.com"
            />
          </div>

          <div>
            <label for="subject" class="block text-sm font-medium text-gray-700 mb-1">
              Sujet
            </label>
            <input
              type="text"
              id="subject"
              name="subject"
              class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:ring-2 focus:ring-[#1E3A8A] focus:border-transparent transition"
              placeholder="Demande de devis"
            />
          </div>

          <div>
            <label for="message" class="block text-sm font-medium text-gray-700 mb-1">
              Message
            </label>
            <textarea
              id="message"
              name="message"
              rows="5"
              required
              class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:ring-2 focus:ring-[#1E3A8A] focus:border-transparent transition resize-none"
              placeholder="Décrivez votre projet..."
            ></textarea>
          </div>

          <button
            id="submit-btn"
            type="submit"
            class="w-full bg-[#1E3A8A] text-white font-semibold py-3 px-6 rounded-lg hover:bg-[#1E3A8A]/90 transition shadow-md hover:shadow-lg"
          >
            Envoyer le message
          </button>

          <p
            id="form-message"
            class="hidden rounded-lg p-4 text-sm font-medium"
          ></p>
        </form>
      </div>

      <!-- Infos de contact -->
      <div class="space-y-8">
        <div>
          <h2 class="text-xl font-semibold text-[#1E3A8A] mb-4">Autres moyens</h2>
          <p class="text-gray-600 mb-6">
            Vous pouvez aussi nous contacter directement via :
          </p>

          <div class="space-y-4">
            <!-- WhatsApp -->
            <a
              href="https://wa.me/22996427604"
              target="_blank"
              rel="noopener noreferrer"
              class="w-14 h-14 bg-[#25D366] text-white rounded-full flex items-center justify-center hover:scale-110 transition"
              aria-label="WhatsApp"
            >
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            </a>
          </div>
        </div>

        <!-- Réseaux sociaux -->
        <div>
          <h3 class="text-lg font-semibold text-[#1E3A8A] mb-4">Suivez-nous</h3>
          <div class="flex flex-wrap gap-4">
            <a
              href="https://www.facebook.com/share/18DPKwjdcL/?mibextid=wwXIfr"
              target="_blank"
              rel="noopener noreferrer"
              class="w-14 h-14 bg-[#1877F2] text-white rounded-full flex items-center justify-center hover:scale-110 transition"
              aria-label="Facebook"
            >
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            </a>
            <a
              href="https://www.linkedin.com/company/alayde-tech"
              target="_blank"
              rel="noopener noreferrer"
              class="w-14 h-14 bg-[#0A66C2] text-white rounded-full flex items-center justify-center hover:scale-110 transition"
              aria-label="LinkedIn"
            >
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            </a>
            <a
              href="https://github.com/m-tech-cod"
              target="_blank"
              rel="noopener noreferrer"
              class="w-14 h-14 bg-[#181717] text-white rounded-full flex items-center justify-center hover:scale-110 transition"
              aria-label="GitHub"
            >
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const form = document.getElementById("contact-form");
    const message = document.getElementById("form-message");
    const button = document.getElementById("submit-btn");
    const originalText = button.innerHTML;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      message.classList.add("hidden");

      button.disabled = true;
      button.innerHTML = `
        <svg class="animate-spin h-5 w-5 inline-block mr-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
        </svg>
        Envoi en cours...
      `;
      button.classList.add("opacity-70", "cursor-not-allowed");

      const data = new FormData(form);

      const icons = {
        success: '<svg class="w-4 h-4 inline-block mr-1 -mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 12l2 2 4-4m5 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>',
        error: '<svg class="w-4 h-4 inline-block mr-1 -mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 9l-6 6m0-6l6 6m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>',
      };

      try {
        const response = await fetch(form.action, {
          method: "POST",
          body: data,
          headers: {
            Accept: "application/json"
          }
        });

        if (response.ok) {
          message.className = "mt-4 rounded-lg bg-green-100 text-green-800 p-4 text-sm font-medium";
          message.innerHTML = `${icons.success}Merci ! Votre message a bien été envoyé. Nous vous répondrons dans les plus brefs délais.`;
          message.classList.remove("hidden");
          form.reset();

          setTimeout(() => {
            message.classList.add("hidden");
          }, 6000);

          button.classList.remove("opacity-70", "cursor-not-allowed");
          button.innerHTML = `${icons.success}Message envoyé`;
          button.classList.remove("bg-[#1E3A8A]");
          button.classList.add("bg-green-600");

          setTimeout(() => {
            button.disabled = false;
            button.innerHTML = originalText;
            button.classList.remove("bg-green-600");
            button.classList.add("bg-[#1E3A8A]");
          }, 1000);
        } else {
          button.disabled = false;
          button.innerHTML = originalText;
          button.classList.remove("opacity-70", "cursor-not-allowed");

          message.className = "mt-4 rounded-lg bg-red-100 text-red-800 p-4 text-sm font-medium";
          message.innerHTML = `${icons.error}Une erreur est survenue. Veuillez réessayer.`;
          message.classList.remove("hidden");

          setTimeout(() => {
            message.classList.add("hidden");
          }, 6000);
        }
      } catch (error) {
        button.disabled = false;
        button.innerHTML = originalText;
        button.classList.remove("opacity-70", "cursor-not-allowed");

        message.className = "mt-4 rounded-lg bg-red-100 text-red-800 p-4 text-sm font-medium";
        message.innerHTML = `${icons.error}Impossible d'envoyer le message. Vérifiez votre connexion.`;
        message.classList.remove("hidden");
      }
    });
  });
</script>