const strokeOnly = new Set([
  "laptop",
  "globe",
  "leaf",
  "bolt",
  "handshake",
  "cloud",
  "building",
  "wrench",
  "target",
  "star-outline",
  "check-circle",
  "x-circle",
  "book-open",
  "lightbulb",
  "palette",
  "check",
  "arrow-right",
]);

const isOutline = strokeOnly.has(name);
const d = name === "star-outline" ? paths.star : paths[name];
---

{isOutline ? (
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    class={className}
    aria-hidden="true"
  >
    <path d={d} />
  </svg>
) : (
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="currentColor"
    class={className}
    aria-hidden="true"
  >
    <path d={d} />
  </svg>
)}
