{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.alaydetech.com" }],
      "destination": "https://alaydetech.com/:path*",
      "permanent": true
    },
    {
      "source": "/blog/5-raisons-digitaliser-association",
      "destination": "/blog/pourquoi-site-web-association-ong",
      "permanent": true
    },
    {
      "source": "/blog/solutions-digitales-ong",
      "destination": "/blog/pourquoi-site-web-association-ong",
      "permanent": true
    },
    {
      "source": "/blog/site-association-education-burkina-humanitaire",
      "destination": "/blog/site-web-association-humanitaire-icmda",
      "permanent": true
    },
    {
      "source": "/blog/site-web-association-solidarite-ya-tchegbo",
      "destination": "/blog/site-web-association-humanitaire-icmda",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://formspree.io; form-action 'self' https://formspree.io; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
